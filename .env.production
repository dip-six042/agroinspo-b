# Render reads these from the dashboard or from render.yaml.
# Do not copy this file over .env on your machine; local dev stays on localhost.

NODE_ENV=production

# Public site. Verification and password-reset links use this.
APP_URL=https://agroinspo-f.vercel.app

# Browser origin allowed to POST to the API. No spaces.
ALLOWED_ORIGINS=https://agroinspo-f.vercel.app

# Public API URL. Kora webhooks would call this. Vercel proxies the site's /api here.
API_PUBLIC_URL=https://agroinspo-api.onrender.com

# Render sets PORT itself. Leave this unset on Render.
# PORT=

# Free instance disk is wiped on redeploy. npm start runs the seed again so demo data comes back.
DATABASE_FILE=./data/agroinspo.db
UPLOAD_DIR=./data/uploads

SEED_PASSWORD=agroinspo-demo-2026
# seed.js exits in production unless this is set. The start command seeds demo accounts.
ALLOW_SEED=1

KORA_MODE=dummy
KORA_SECRET_KEY=
VIDEO_PROVIDER=dummy
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

JOB_FEE_STANDARD_NGN=10000
JOB_FEE_FEATURED_NGN=25000
COMMISSION_CONSULTATION_PCT=15
COMMISSION_EVENT_PCT=15
COMMISSION_BOOK_PCT=20
COMMISSION_SPONSORSHIP_PCT=15
HOLD_DAYS_CONSULTATION=3
HOLD_DAYS_EVENT=3
HOLD_DAYS_BOOK=7
HOLD_DAYS_SPONSORSHIP=7
MIN_PAYOUT_NGN=5000
CLIENT_FREE_CANCEL_HOURS=24
BOOK_REFUND_DAYS=7
ALLOW_PAYOUT_SELF_APPROVAL=

AD_FEED_7D_NGN=15000
AD_FEED_14D_NGN=25000
AD_FEED_30D_NGN=45000
AD_EVENTS_7D_NGN=10000
AD_EVENTS_14D_NGN=17000
AD_EVENTS_30D_NGN=30000
AD_JOBS_7D_NGN=10000
AD_JOBS_14D_NGN=17000
AD_JOBS_30D_NGN=30000
