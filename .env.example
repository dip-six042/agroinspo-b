# Copy to .env and adjust. The server reads it automatically (Node >= 22.13).

# Public URL of the site. Used in verification and password-reset links.
APP_URL="http://localhost:3000"

# Comma-separated origins allowed to call the API (CSRF protection).
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8787"

# API port.
PORT=8787

# SQLite file location (created on first run).
DATABASE_FILE="./data/agroinspo.db"

# Set to production when deploying: secure cookies on, dev links and /api/dev/outbox off.
NODE_ENV=development

# Password for `npm run seed` demo accounts (development only).
SEED_PASSWORD="agroinspo-demo-2026"

# ---- Payments (Kora / Korapay) ----
# dummy = local test checkout, no network calls (default). test / live = real Kora API.
KORA_MODE=dummy
# Required for test/live. Also used to verify webhook signatures.
KORA_SECRET_KEY=""
# Public URL Kora can reach for webhooks (POST /api/payments/webhook). Defaults to APP_URL.
API_PUBLIC_URL=""

# Placeholder job listing fees in naira, until the rate card is approved.
JOB_FEE_STANDARD_NGN=10000
JOB_FEE_FEATURED_NGN=25000

# ---- Live video ----
# dummy = simulated stage (default). agora = real calls (see server/video.js).
VIDEO_PROVIDER=dummy
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Where private uploads (CVs) are stored. Never inside a public folder.
UPLOAD_DIR="./data/uploads"

# ---- Phase 3: money rules (PLACEHOLDERS until the owner approves the rate card) ----
# Platform commission per sale, in percent.
COMMISSION_CONSULTATION_PCT=10
COMMISSION_EVENT_PCT=10
COMMISSION_BOOK_PCT=10
# Days after the session/sale before earnings become available (the dispute/refund window).
HOLD_DAYS_CONSULTATION=3
HOLD_DAYS_EVENT=3
HOLD_DAYS_BOOK=7
# Smallest available balance included in a payout batch.
MIN_PAYOUT_NGN=5000
# Clients cancelling at least this many hours before a consultation get a full refund.
CLIENT_FREE_CANCEL_HOURS=24
# Book buyers can ask for a refund within this many days.
BOOK_REFUND_DAYS=7
# Development only. 1 lets the admin who prepared a payout batch also approve it.
# Leave unset in production: a second admin must approve (maker-checker).
ALLOW_PAYOUT_SELF_APPROVAL=

# ---- Phase 4: advertising & sponsorship (PLACEHOLDER prices until the rate card is approved) ----
# Advert prices in naira by placement and length.
AD_FEED_7D_NGN=15000
AD_FEED_14D_NGN=25000
AD_FEED_30D_NGN=45000
AD_EVENTS_7D_NGN=10000
AD_EVENTS_14D_NGN=17000
AD_EVENTS_30D_NGN=30000
AD_JOBS_7D_NGN=10000
AD_JOBS_14D_NGN=17000
AD_JOBS_30D_NGN=30000
# Platform commission on event sponsorship fees, and days after the event before the host can be paid.
COMMISSION_SPONSORSHIP_PCT=10
HOLD_DAYS_SPONSORSHIP=7
